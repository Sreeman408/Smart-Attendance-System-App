{
  "appId": "edu.annamalai.cms",
  "appName": "Annamalai University CMS",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "Camera": {
      "permissions": ["camera"]
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#800020",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#800020"
    }
  }
}
